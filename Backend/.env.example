# Cấu hình Database MySQL (Chuẩn)
# Cú pháp: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:123456@localhost:3306/dat_san_bong

# Nếu bạn chưa cài hoặc chưa bật MySQL Server, có thể đặt USE_SQLITE=true để chạy thử ngay
USE_SQLITE=false

# Cấu hình JWT Authentication
# LƯU Ý BẢO MẬT: Thay đổi chuỗi bí mật này trong môi trường sản xuất!
SECRET_KEY=yenphu_football_super_secret_jwt_key_2026_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cấu hình CORS (Cho phép Frontend gọi API)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

